# Copy to .env next to docker-compose.yml, then edit the secrets.
#   cp env.example .env
#   chmod 600 .env
#
# This file is consumed twice:
#   1. By Compose itself for ${VAR} interpolation inside docker-compose.yml.
#   2. As the contract for what the backend expects at runtime.
#
# Keep the DB_* values identical to what Postgres was initialised with.
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD are only honoured on an
# EMPTY data volume — editing them afterwards silently does nothing.

# ---------------------------------------------------------------------------
# Host
# ---------------------------------------------------------------------------
TZ=Asia/Bangkok

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
DB_NAME=ratewatch_db
DB_USERNAME=postgre
DB_PASSWORD=change-me-please-use-openssl-rand-base64-24
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me-too
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
APP_PORT=8081
APP_VERSION=local
ALLOWED_ORIGINS=http://localhost:5173

# Host directory for the JSON log files (must exist before first `up`).
LOG_DIR=/srv/ratewatch/logs

# Uncomment to tune the JVM. Defaults set in docker-compose.yml.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError

# ---------------------------------------------------------------------------
# Not in this stack (Supabase is Cloud free tier, per AGENTS.md scope)
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
