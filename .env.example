# =============================================================================
# RateWatch — development environment file
#
# Spring Boot does NOT read this file by itself. It is read by:
#   - Docker Compose (the production stack keeps its own .env next to
#     deployment-overview/compose/docker-compose.yml), and
#   - your IDE run configuration, or a shell:
#         set -a && . ./.env && set +a
#
# Copy this file to .env, fill in the blanks, never commit .env.
# =============================================================================

# -------------------------
# Database (dev)
# Postgres runs in Docker on the homelab; `localhost` here only works when the
# SSH tunnel is up (see deployment-overview/04-ssh-access-model.md).
# -------------------------

DB_NAME=ratewatch_db
DB_USERNAME=postgre
DB_PASSWORD=
DB_PORT=5432
DB_HOST=localhost

# -------------------------
# Application
# -------------------------

APP_PORT=8081
ALLOWED_ORIGINS=http://localhost:5173

# -------------------------
# External rate API (US-01)
#
# Must be an absolute URL. app.api.base-url binds it as a java.net.URI, so an
# empty or relative value fails at startup instead of at the first call.
# Change it only to point US-09's failure simulation at a mock server.
# -------------------------

RATE_API_BASE_URL=https://open.er-api.com/v6

# -------------------------
# Redis (US-05) — not wired yet
#
# These names do nothing today: no application-*.yaml maps spring.data.redis.*,
# and spring-boot-starter-data-redis therefore falls back to localhost:6379.
# Add the mapping first, then uncomment.
# -------------------------

# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# -------------------------
# Supabase (US-06) — transport not decided
# -------------------------

# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
